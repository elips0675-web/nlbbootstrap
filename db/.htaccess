# Миграции и проверки БД — только из консоли.
# Веб-доступ закрыт: скрипты меняют инфоблоки и не должны вызываться из браузера.
# Для nginx добавьте в конфиг сайта:
#     location ^~ /db/ { deny all; }
#
# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
