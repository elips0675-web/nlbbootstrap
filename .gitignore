# Служебные и временные файлы — не коммитим.

# Логи миграций (каталог нужен, файлы — нет)
db/logs/*.log

# Временные файлы гейтов и сборки
tmp/
.tmp-*
*.tmp

# Секреты и окружение
.env
.env.*
*.pem
*.key

# Ключи VAPID для Web Push (создаёт tools/gen-vapid.php)
local/php_interface/include/nlb_push_keys.php

# ОС и редакторы
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Node (нужен только для локальных гейтов)
node_modules/
npm-debug.log*

# Архивы и дампы
*.zip
*.7z
*.sql.gz

# Vercel build output (tools/vercel-build.mjs)
public/
